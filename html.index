<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ofuscador + Pastefy</title>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body {
    font-family: 'Segoe UI', sans-serif;
    background: #0f0f0f;
    color: #e0e0e0;
    min-height: 100vh;
    padding: 2rem;
  }
  h1 {
    text-align: center;
    font-size: 1.6rem;
    margin-bottom: 0.3rem;
    color: #a78bfa;
  }
  p.sub {
    text-align: center;
    font-size: 0.85rem;
    color: #888;
    margin-bottom: 1.5rem;
  }
  .card {
    background: #1a1a1a;
    border: 1px solid #2e2e2e;
    border-radius: 12px;
    padding: 1.25rem;
    margin-bottom: 1.2rem;
  }
  label {
    display: block;
    font-size: 0.8rem;
    color: #aaa;
    margin-bottom: 0.4rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  textarea {
    width: 100%;
    background: #0f0f0f;
    border: 1px solid #333;
    border-radius: 8px;
    color: #e0e0e0;
    font-family: 'Courier New', monospace;
    font-size: 0.85rem;
    padding: 0.75rem;
    resize: vertical;
    min-height: 160px;
    outline: none;
    transition: border-color 0.2s;
  }
  textarea:focus { border-color: #7c3aed; }
  .row { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  button {
    flex: 1;
    min-width: 140px;
    padding: 0.65rem 1rem;
    border: none;
    border-radius: 8px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s, transform 0.1s;
  }
  button:active { transform: scale(0.97); }
  button:disabled { opacity: 0.45; cursor: not-allowed; }
  .btn-primary { background: #7c3aed; color: #fff; }
  .btn-primary:hover:not(:disabled) { background: #6d28d9; }
  .btn-success { background: #059669; color: #fff; }
  .btn-success:hover:not(:disabled) { background: #047857; }
  .btn-copy { background: #1f2937; color: #d1d5db; border: 1px solid #374151; }
  .btn-copy:hover { background: #374151; }
  .btn-link { background: #0369a1; color: #fff; }
  .btn-link:hover:not(:disabled) { background: #0284c7; }
  .status {
    font-size: 0.82rem;
    padding: 0.5rem 0.75rem;
    border-radius: 6px;
    margin-top: 0.75rem;
    display: none;
  }
  .status.info { background: #1e3a5f; color: #93c5fd; display: block; }
  .status.ok   { background: #064e3b; color: #6ee7b7; display: block; }
  .status.err  { background: #450a0a; color: #fca5a5; display: block; }
  .raw-box {
    display: none;
    margin-top: 0.75rem;
  }
  .raw-url {
    background: #0f0f0f;
    border: 1px solid #7c3aed;
    border-radius: 8px;
    padding: 0.6rem 0.75rem;
    font-family: monospace;
    font-size: 0.8rem;
    color: #c4b5fd;
    word-break: break-all;
  }
</style>
</head>
<body>

<h1>⬡ Ofuscador + Pastefy</h1>
<p class="sub">Ofusca tu código y súbelo directo a Pastefy para obtener el RAW</p>

<!-- INPUT -->
<div class="card">
  <label>Código original</label>
  <textarea id="inputCode" placeholder="Pega aquí tu código..."></textarea>
  <div style="margin-top:0.75rem;">
    <label>Nivel de ofuscación</label>
    <select id="level" style="background:#0f0f0f;border:1px solid #333;border-radius:8px;color:#e0e0e0;padding:0.5rem 0.75rem;width:100%;font-size:0.9rem;outline:none;">
      <option value="1">Básico — nombres cortos</option>
      <option value="2" selected>Medio — base64 + eval</option>
      <option value="3">Máximo — hex encoding</option>
    </select>
  </div>
  <div class="row" style="margin-top:0.75rem;">
    <button class="btn-primary" onclick="ofuscar()">⚡ Ofuscar</button>
    <button class="btn-copy" onclick="copiarInput()">📋 Copiar original</button>
  </div>
</div>

<!-- OUTPUT -->
<div class="card">
  <label>Código ofuscado</label>
  <textarea id="outputCode" placeholder="El resultado aparecerá aquí..." readonly></textarea>
  <div class="row" style="margin-top:0.75rem;">
    <button class="btn-copy" onclick="copiarOutput()">📋 Copiar ofuscado</button>
    <button class="btn-success" id="btnSubir" onclick="subirPastefy()" disabled>🚀 Subir a Pastefy</button>
  </div>
  <div class="status" id="status"></div>
  <div class="raw-box" id="rawBox">
    <label style="margin-top:0.75rem;">RAW link</label>
    <div class="raw-url" id="rawUrl"></div>
    <div class="row" style="margin-top:0.6rem;">
      <button class="btn-copy" onclick="copiarRaw()">📋 Copiar RAW URL</button>
      <button class="btn-link" onclick="abrirRaw()">🔗 Abrir RAW</button>
    </div>
  </div>
</div>

<script>
let lastRawUrl = '';

function setStatus(msg, type) {
  const el = document.getElementById('status');
  el.textContent = msg;
  el.className = 'status ' + type;
}

function ofuscar() {
  const code = document.getElementById('inputCode').value.trim();
  if (!code) { setStatus('⚠ Pega código primero.', 'err'); return; }

  const level = parseInt(document.getElementById('level').value);
  let result = '';

  if (level === 1) {
    result = basicObfuscate(code);
  } else if (level === 2) {
    result = mediumObfuscate(code);
  } else {
    result = heavyObfuscate(code);
  }

  document.getElementById('outputCode').value = result;
  document.getElementById('btnSubir').disabled = false;
  setStatus('✅ Ofuscación completada. Ahora puedes subirlo a Pastefy.', 'ok');
}

function basicObfuscate(code) {
  const vars = {};
  let counter = 0;
  const alpha = 'abcdefghijklmnopqrstuvwxyz';
  const genName = () => {
    const i = counter++;
    return '_' + alpha[i % 26] + (i >= 26 ? Math.floor(i/26) : '');
  };
  return code.replace(/\b(var|let|const)\s+([a-zA-Z_$][a-zA-Z0-9_$]*)/g, (m, kw, name) => {
    if (!vars[name]) vars[name] = genName();
    return kw + ' ' + vars[name];
  }).replace(/\b([a-zA-Z_$][a-zA-Z0-9_$]*)\b/g, (m) => vars[m] || m);
}

function mediumObfuscate(code) {
  const b64 = btoa(unescape(encodeURIComponent(code)));
  return `eval(function(p,a,c,k,e,d){e=function(c){return c};if(!''.replace(/^/,String)){while(c--)d[c]=k[c]||c;k=[function(e){return d[e]}];e=function(){return'\\\\w+'};c=1};while(c--)if(k[c])p=p.replace(new RegExp('\\\\b'+e(c)+'\\\\b','g'),k[c]);return p}('eval(decodeURIComponent(escape(atob("${b64}"))))',1,1,''.split('|'),0,{}))`;
}

function heavyObfuscate(code) {
  const hex = Array.from(new TextEncoder().encode(code))
    .map(b => '\\x' + b.toString(16).padStart(2, '0')).join('');
  return `(function(){var _0x1a2b="${hex}";var _0x3c4d=_0x1a2b.split('').map(function(c){return c}).join('');eval(decodeURIComponent(Array.from(_0x3c4d.match(/\\\\x[0-9a-f]{2}/g)||[]).map(function(h){return'%'+h.slice(2)}).join('')));})();`;
}

async function subirPastefy() {
  const code = document.getElementById('outputCode').value.trim();
  if (!code) return;

  document.getElementById('btnSubir').disabled = true;
  setStatus('⏳ Subiendo a Pastefy...', 'info');

  try {
    const res = await fetch('https://pastefy.app/api/v2/paste', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        content: code,
        title: 'Obfuscated Code',
        type: 'PASTE',
        visibility: 'UNLISTED'
      })
    });

    const data = await res.json();

    if (data && data.paste && data.paste.id) {
      const id = data.paste.id;
      lastRawUrl = `https://pastefy.app/${id}/raw`;
      document.getElementById('rawUrl').textContent = lastRawUrl;
      document.getElementById('rawBox').style.display = 'block';
      setStatus('✅ Subido exitosamente a Pastefy.', 'ok');
    } else {
      throw new Error('Respuesta inesperada de Pastefy');
    }
  } catch (e) {
    setStatus('❌ Error al subir: ' + e.message + '. Intenta de nuevo.', 'err');
  }

  document.getElementById('btnSubir').disabled = false;
}

function copiarInput() {
  const v = document.getElementById('inputCode').value;
  if (!v) return;
  navigator.clipboard.writeText(v);
  setStatus('📋 Código original copiado.', 'ok');
}

function copiarOutput() {
  const v = document.getElementById('outputCode').value;
  if (!v) return;
  navigator.clipboard.writeText(v);
  setStatus('📋 Código ofuscado copiado.', 'ok');
}

function copiarRaw() {
  if (!lastRawUrl) return;
  navigator.clipboard.writeText(lastRawUrl);
  setStatus('📋 RAW URL copiada.', 'ok');
}

function abrirRaw() {
  if (!lastRawUrl) return;
  window.open(lastRawUrl, '_blank');
}
</script>
</body>
</html>
