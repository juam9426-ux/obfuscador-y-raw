<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ofuscador de Código</title>
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #0f1117;
      --surface: #1a1d27;
      --surface2: #22263a;
      --border: #2e3250;
      --border-hover: #4a4f7a;
      --accent: #7c6dfa;
      --accent-dim: #3d3580;
      --text: #e8eaf6;
      --text-muted: #8891b8;
      --text-dim: #555e88;
      --green: #4ade80;
      --green-bg: #0d2b1a;
      --amber: #fbbf24;
      --amber-bg: #2a1f06;
      --red: #f87171;
      --radius: 8px;
      --font-mono: 'Cascadia Code', 'Fira Code', 'JetBrains Mono', 'Consolas', monospace;
      --font-sans: 'Inter', system-ui, sans-serif;
    }

    body {
      background: var(--bg);
      color: var(--text);
      font-family: var(--font-sans);
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* ── NAV ── */
    nav {
      padding: 16px 32px;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
      background: var(--surface);
    }
    nav .logo {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.3px;
      color: var(--text);
    }
    nav .logo svg { opacity: 0.9; }
    nav .tag {
      font-size: 11px;
      background: var(--accent-dim);
      color: var(--accent);
      padding: 2px 8px;
      border-radius: 20px;
      font-weight: 500;
      margin-left: 4px;
    }

    /* ── MAIN ── */
    main {
      flex: 1;
      max-width: 900px;
      width: 100%;
      margin: 0 auto;
      padding: 32px 24px 64px;
    }

    .page-title {
      font-size: 26px;
      font-weight: 700;
      letter-spacing: -0.5px;
      margin-bottom: 6px;
    }
    .page-sub {
      font-size: 14px;
      color: var(--text-muted);
      margin-bottom: 28px;
    }

    /* ── TABS ── */
    .tabs {
      display: flex;
      gap: 4px;
      margin-bottom: 14px;
      background: var(--surface);
      border: 1px solid var(--border);
      padding: 4px;
      border-radius: var(--radius);
      width: fit-content;
    }
    .tab {
      padding: 6px 16px;
      font-size: 13px;
      border: none;
      border-radius: 6px;
      cursor: pointer;
      background: transparent;
      color: var(--text-muted);
      font-family: var(--font-sans);
      transition: all 0.15s;
      font-weight: 500;
    }
    .tab:hover { color: var(--text); background: var(--surface2); }
    .tab.active { background: var(--accent); color: #fff; }

    /* ── EDITOR ── */
    .editor-label {
      font-size: 12px;
      color: var(--text-dim);
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin-bottom: 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .char-count { font-size: 12px; color: var(--text-dim); }

    textarea {
      width: 100%;
      height: 220px;
      padding: 16px;
      font-family: var(--font-mono);
      font-size: 13px;
      line-height: 1.7;
      background: var(--surface);
      color: var(--text);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      resize: vertical;
      outline: none;
      transition: border-color 0.15s;
    }
    textarea:focus { border-color: var(--accent); }
    textarea::placeholder { color: var(--text-dim); }

    /* ── CONTROLS ── */
    .controls {
      display: flex;
      gap: 10px;
      margin: 16px 0;
      flex-wrap: wrap;
      align-items: center;
    }

    .level-wrap {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      color: var(--text-muted);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 0 12px;
      height: 38px;
      background: var(--surface);
    }
    .level-wrap select {
      background: transparent;
      border: none;
      color: var(--text);
      font-size: 13px;
      font-family: var(--font-sans);
      cursor: pointer;
      outline: none;
    }
    .level-wrap select option { background: var(--surface2); }

    .btn {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      padding: 0 18px;
      height: 38px;
      font-size: 13px;
      font-weight: 600;
      font-family: var(--font-sans);
      border-radius: var(--radius);
      border: 1px solid var(--border);
      cursor: pointer;
      background: var(--surface);
      color: var(--text);
      transition: all 0.15s;
    }
    .btn:hover { border-color: var(--border-hover); background: var(--surface2); }
    .btn:active { transform: scale(0.97); }
    .btn-accent { background: var(--accent); border-color: var(--accent); color: #fff; }
    .btn-accent:hover { opacity: 0.88; background: var(--accent); }
    .btn-ghost { color: var(--text-muted); }
    .btn-ghost:hover { color: var(--red); border-color: var(--red); }

    /* ── OUTPUTS ── */
    .outputs { display: flex; flex-direction: column; gap: 20px; margin-top: 24px; }

    .output-card {
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--surface);
      overflow: hidden;
      display: none;
    }
    .output-card.show { display: block; }

    .output-header {
      padding: 12px 16px;
      border-bottom: 1px solid var(--border);
      display: flex;
      justify-content: space-between;
      align-items: center;
      background: var(--surface2);
      flex-wrap: wrap;
      gap: 10px;
    }
    .output-title {
      display: flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      font-weight: 600;
    }
    .badge {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.6px;
      padding: 2px 8px;
      border-radius: 20px;
      text-transform: uppercase;
    }
    .badge-raw { background: var(--green-bg); color: var(--green); border: 1px solid #1a4d2e; }
    .badge-obf { background: var(--amber-bg); color: var(--amber); border: 1px solid #4a3010; }

    .copy-btn {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 12px;
      font-size: 12px;
      font-family: var(--font-sans);
      border: 1px solid var(--border);
      border-radius: 6px;
      cursor: pointer;
      background: transparent;
      color: var(--text-muted);
      transition: all 0.15s;
    }
    .copy-btn:hover { border-color: var(--border-hover); color: var(--text); }
    .copy-btn.copied { color: var(--green); border-color: var(--green); }

    .output-body {
      padding: 16px;
      font-family: var(--font-mono);
      font-size: 12.5px;
      line-height: 1.7;
      color: var(--text);
      word-break: break-all;
      white-space: pre-wrap;
      max-height: 260px;
      overflow-y: auto;
    }
    .output-body::-webkit-scrollbar { width: 6px; }
    .output-body::-webkit-scrollbar-track { background: transparent; }
    .output-body::-webkit-scrollbar-thumb { background: var(--border-hover); border-radius: 3px; }

    .output-footer {
      padding: 10px 16px;
      border-top: 1px solid var(--border);
      display: flex;
      gap: 10px;
      flex-wrap: wrap;
    }
    .stat {
      font-size: 11px;
      color: var(--text-dim);
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .stat strong { color: var(--text-muted); font-weight: 600; }

    /* ── MODAL PARA PASTEFY ── */
    .modal {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0,0,0,0.7);
      z-index: 1000;
      align-items: center;
      justify-content: center;
    }
    .modal.show { display: flex; }
    .modal-content {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 20px;
      max-width: 400px;
      width: 90%;
    }
    .modal-title {
      font-size: 16px;
      font-weight: 600;
      margin-bottom: 12px;
    }
    .modal-input {
      width: 100%;
      padding: 10px;
      background: var(--surface2);
      border: 1px solid var(--border);
      color: var(--text);
      font-family: var(--font-mono);
      font-size: 12px;
      border-radius: 6px;
      margin-bottom: 12px;
      word-break: break-all;
    }
    .modal-buttons {
      display: flex;
      gap: 10px;
    }
    .modal-btn {
      flex: 1;
      padding: 8px 12px;
      border: 1px solid var(--border);
      background: var(--surface2);
      color: var(--text);
      border-radius: 6px;
      cursor: pointer;
      font-weight: 500;
      transition: all 0.15s;
    }
    .modal-btn:hover { border-color: var(--border-hover); background: var(--surface); }
    .modal-btn-accent {
      background: var(--accent);
      border-color: var(--accent);
      color: #fff;
    }
    .modal-btn-accent:hover { opacity: 0.88; }

    /* ── EMPTY ── */
    .empty {
      text-align: center;
      padding: 48px 20px;
      color: var(--text-dim);
      font-size: 14px;
      border: 1px dashed var(--border);
      border-radius: var(--radius);
      margin-top: 24px;
      display: none;
    }
    .empty svg { margin-bottom: 12px; opacity: 0.3; }
    .empty p { color: var(--text-muted); margin-bottom: 4px; font-size: 15px; }
    .empty span { font-size: 13px; }

    footer {
      text-align: center;
      padding: 20px;
      font-size: 12px;
      color: var(--text-dim);
      border-top: 1px solid var(--border);
    }
  </style>
</head>
<body>

<nav>
  <div class="logo">
    <svg width="20" height="20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
    </svg>
    CodeObfuscator
    <span class="tag">v2.0</span>
  </div>
</nav>

<main>
  <h1 class="page-title">Ofuscador de código</h1>
  <p class="page-sub">Pega tu código, elige el lenguaje y transforma a versión ofuscada y raw simultáneamente.</p>

  <div class="tabs">
    <button class="tab active" onclick="setLang('js')">JavaScript</button>
    <button class="tab" onclick="setLang('css')">CSS</button>
    <button class="tab" onclick="setLang('html')">HTML</button>
    <button class="tab" onclick="setLang('generic')">Genérico</button>
  </div>

  <div class="editor-label">
    <span>Código fuente</span>
    <span class="char-count" id="charCount">0 caracteres</span>
  </div>

  <textarea id="input" spellcheck="false"
    placeholder="// Pega tu código aquí...
function saludar(nombre) {
  const mensaje = 'Hola, ' + nombre + '!';
  console.log(mensaje);
  return mensaje;
}"
    oninput="updateCount()"></textarea>

  <div class="controls">
    <div class="level-wrap">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path d="M12 20h9M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
      <label for="level">Nivel:</label>
      <select id="level">
        <option value="light">Suave — minificar</option>
        <option value="medium" selected>Medio — renombrar</option>
        <option value="heavy">Fuerte — ilegible</option>
      </select>
    </div>

    <button class="btn btn-accent" onclick="obfuscate()">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
      Ofuscar + Raw
    </button>

    <button class="btn btn-ghost" onclick="clearAll()">
      <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 01-2 2H8a2 2 0 01-2-2L5 6m3 0V4a1 1 0 011-1h4a1 1 0 011 1v2"/></svg>
      Limpiar
    </button>
  </div>

  <div class="outputs">
    <!-- RAW -->
    <div class="output-card" id="rawCard">
      <div class="output-header">
        <div class="output-title">
          <span class="badge badge-raw">RAW</span>
          Código comprimido en una línea
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="copy-btn" id="copyRaw" onclick="copyText('rawOut','copyRaw')">
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copiar
          </button>
          <button class="copy-btn" id="shareRaw" onclick="generatePasteLink('rawOut')">
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Generar link
          </button>
        </div>
      </div>
      <div class="output-body" id="rawOut"></div>
      <div class="output-footer" id="rawStats"></div>
    </div>

    <!-- OFUSCADO -->
    <div class="output-card" id="obfCard">
      <div class="output-header">
        <div class="output-title">
          <span class="badge badge-obf">OFUSCADO</span>
          Código transformado
        </div>
        <div style="display: flex; gap: 8px;">
          <button class="copy-btn" id="copyObf" onclick="copyText('obfOut','copyObf')">
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg>
            Copiar
          </button>
          <button class="copy-btn" id="shareObf" onclick="generatePasteLink('obfOut')">
            <svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
            Generar link
          </button>
        </div>
      </div>
      <div class="output-body" id="obfOut"></div>
      <div class="output-footer" id="obfStats"></div>
    </div>
  </div>
</main>

<!-- MODAL PARA MOSTRAR LINK DE PASTEFY -->
<div class="modal" id="pasteModal">
  <div class="modal-content">
    <div class="modal-title">Link de Pastefy generado</div>
    <div class="modal-input" id="pasteLink" style="background: var(--surface2); padding: 12px; border-radius: 6px; word-break: break-all; max-height: 100px; overflow-y: auto;">
      Cargando...
    </div>
    <div class="modal-buttons">
      <button class="modal-btn" onclick="copyPasteLink()">📋 Copiar link</button>
      <button class="modal-btn" onclick="openPasteLink()">🔗 Abrir en navegador</button>
      <button class="modal-btn modal-btn-accent" onclick="closeModal()">Cerrar</button>
    </div>
  </div>
</div>

<footer>Herramienta local — tu código nunca sale del navegador (excepto al compartir con Pastefy).</footer>

<script>
let currentLang = 'js';
let lastPasteLink = '';

function updateCount() {
  const len = document.getElementById('input').value.length;
  document.getElementById('charCount').textContent = len.toLocaleString() + ' caracteres';
}

function setLang(lang) {
  currentLang = lang;
  document.querySelectorAll('.tab').forEach((t, i) => {
    t.classList.toggle('active', ['js','css','html','generic'][i] === lang);
  });
  const placeholders = {
    js: `// JavaScript\nfunction saludar(nombre) {\n  const mensaje = 'Hola, ' + nombre + '!';\n  console.log(mensaje);\n  return mensaje;\n}`,
    css: `/* CSS */\n.contenedor {\n  display: flex;\n  background-color: #ffffff;\n  padding: 20px;\n  margin: 10px auto;\n}`,
    html: `<!-- HTML -->\n<div class="contenedor">\n  <h1>Título principal</h1>\n  <p class="descripcion">Texto de ejemplo</p>\n</div>`,
    generic: `# Python / Genérico\ndef saludar(nombre):\n    mensaje = 'Hola, ' + nombre\n    print(mensaje)\n    return mensaje`
  };
  document.getElementById('input').placeholder = placeholders[lang];
}

function obfuscate() {
  const code = document.getElementById('input').value.trim();
  if (!code) return alert('Pega algún código primero.');
  const level = document.getElementById('level').value;

  // Generar raw
  const raw = code
    .replace(/\/\/[^\n]*/g, '')
    .replace(/\/\*[\s\S]*?\*\//g, '')
    .replace(/<!--[\s\S]*?-->/g, '')
    .replace(/#[^\n]*/g, '')
    .replace(/\s+/g, ' ')
    .replace(/\s*\{\s*/g, '{').replace(/\s*\}\s*/g, '}')
    .replace(/\s*;\s*/g, ';').replace(/\s*:\s*/g, ':')
    .replace(/\s*,\s*/g, ',').replace(/>\s+</g, '><')
    .trim();

  // Generar obfuscado
  let result;
  if (currentLang === 'js' || currentLang === 'generic') result = obfuscateJS(code, level);
  else if (currentLang === 'css') result = obfuscateCSS(code, level);
  else if (currentLang === 'html') result = obfuscateHTML(code, level);
  else result = obfuscateGeneric(code, level);

  // Mostrar AMBAS tarjetas
  document.getElementById('rawCard').classList.add('show');
  document.getElementById('obfCard').classList.add('show');
  
  // Mostrar raw
  document.getElementById('rawOut').textContent = raw;
  document.getElementById('rawStats').innerHTML = buildStats(code, raw);
  
  // Mostrar obfuscado
  document.getElementById('obfOut').textContent = result;
  document.getElementById('obfStats').innerHTML = buildStats(code, result);
}

function obfuscateJS(code, level) {
  let r = code
    .replace(/\/\/[^\n]*/g, '')
    .replace(/\/\*[\s\S]*?\*\//g, '');

  if (level === 'light') {
    return r.replace(/\s+/g,' ').replace(/\s*\{\s*/g,'{').replace(/\s*\}\s*/g,'}')
            .replace(/\s*;\s*/g,';').replace(/\s*,\s*/g,',').trim();
  }

  const keywords = new Set(['function','return','var','let','const','if','else','for','while','do','switch','case','break','continue','new','this','typeof','instanceof','true','false','null','undefined','void','delete','in','of','class','extends','import','export','default','try','catch','finally','throw','async','await','console','log','window','document','Math','JSON','Array','Object','String','Number','Boolean','Promise','alert','parseInt','parseFloat','isNaN','setTimeout','setInterval','clearTimeout','clearInterval']);
  const varMap = {};
  const genName = () => '_0x' + Math.floor(Math.random() * 0xffff).toString(16).padStart(4,'0');

  r = r.replace(/\b([a-zA-Z_$][a-zA-Z0-9_$]*)\b/g, m => {
    if (keywords.has(m) || m.startsWith('_0x')) return m;
    if (!varMap[m]) varMap[m] = genName();
    return varMap[m];
  });

  r = r.replace(/\s+/g,' ').replace(/\s*\{\s*/g,'{').replace(/\s*\}\s*/g,'}')
       .replace(/\s*;\s*/g,';').replace(/\s*,\s*/g,',').trim();

  if (level === 'heavy') {
    r = r.replace(/"([^"]*)"/g, (_,s) => '"' + s.split('').map(c=>'\\x'+c.charCodeAt(0).toString(16)).join('') + '"');
    r = r.replace(/'([^']*)'/g, (_,s) => "'" + s.split('').map(c=>'\\x'+c.charCodeAt(0).toString(16)).join('') + "'");
    r = r.replace(/\b(\d+)\b/g, (_,n) => {
      const num = parseInt(n);
      if (num > 1 && num < 9999) { const a = Math.floor(Math.random()*(num-1))+1; return `(${a}+${num-a})`; }
      return n;
    });
  }
  return r.trim();
}

function obfuscateCSS(code, level) {
  let r = code.replace(/\/\*[\s\S]*?\*\//g, '');
  r = r.replace(/\s+/g,' ').replace(/\s*\{\s*/g,'{').replace(/\s*\}\s*/g,'}')
       .replace(/\s*;\s*/g,';').replace(/\s*:\s*/g,':').trim();
  if (level === 'medium' || level === 'heavy') {
    r = r.replace(/#([0-9a-fA-F]{6})\b/g, (_,h) => {
      const rv=parseInt(h.slice(0,2),16),gv=parseInt(h.slice(2,4),16),bv=parseInt(h.slice(4,6),16);
      return `rgba(${rv},${gv},${bv},1)`;
    });
  }
  if (level === 'heavy') {
    r = r.replace(/:(\d+)px/g, (_,n) => `:${(parseInt(n)/16).toFixed(4)}rem`);
  }
  return r;
}

function obfuscateHTML(code, level) {
  let r = code.replace(/<!--[\s\S]*?-->/g, '');
  r = r.replace(/\s+/g,' ').replace(/>\s+</g,'><').trim();
  if (level === 'medium' || level === 'heavy') {
    r = r.replace(/class="([^"]*)"/g, (_,c) => {
      const n = c.split(' ').map(cls => '_'+Math.abs(hashStr(cls)).toString(16).slice(0,4)).join(' ');
      return `class="${n}"`;
    });
  }
  if (level === 'heavy') {
    r = r.replace(/id="([^"]*)"/g, (_,id) => `id="_${Math.abs(hashStr(id)).toString(16).slice(0,4)}"`);
    r = r.replace(/>([^<]{1,})</g, (_,t) => {
      if (!t.trim()) return _; 
      return '>' + t.trim().split('').map(c=>`&#${c.charCodeAt(0)};`).join('') + '<';
    });
  }
  return r;
}

function obfuscateGeneric(code, level) {
  let r = code
    .replace(/\/\/[^\n]*/g,'')
    .replace(/\/\*[\s\S]*?\*\//g,'')
    .replace(/#[^\n]*/g,'')
    .replace(/\s+/g,' ').trim();
  if (level !== 'light') {
    const kw = new Set(['function','return','var','let','const','if','else','for','while','print','true','false','null','None','def','class','import','from','as','in','and','or','not','is','try','except','finally','with','pass','break','continue','raise','yield','lambda','echo','do','end']);
    r = r.replace(/\b([a-zA-Z_][a-zA-Z0-9_]{2,})\b/g, m => kw.has(m) ? m : '_'+Math.abs(hashStr(m)).toString(16).slice(0,4));
  }
  return r;
}

function hashStr(s) {
  let h = 0;
  for (let i = 0; i < s.length; i++) h = (Math.imul(31,h)+s.charCodeAt(i))|0;
  return h;
}

function buildStats(orig, res) {
  const red = Math.round((1 - res.length / orig.length) * 100);
  const sign = red >= 0 ? '-' : '+';
  return `
    <div class="stat">Original: <strong>${orig.length.toLocaleString()} chars</strong></div>
    <div class="stat">Resultado: <strong>${res.length.toLocaleString()} chars</strong></div>
    <div class="stat">Reducción: <strong>${sign}${Math.abs(red)}%</strong></div>
    <div class="stat">Líneas originales: <strong>${orig.split('\n').length}</strong></div>
  `;
}

function copyText(id, btnId) {
  const text = document.getElementById(id).textContent;
  navigator.clipboard.writeText(text).then(() => {
    const btn = document.getElementById(btnId);
    btn.classList.add('copied');
    btn.innerHTML = `<svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"/></svg> Copiado`;
    setTimeout(() => {
      btn.classList.remove('copied');
      btn.innerHTML = `<svg width="12" height="12" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 01-2-2V4a2 2 0 012-2h9a2 2 0 012 2v1"/></svg> Copiar`;
    }, 2000);
  });
}

async function generatePasteLink(elementId) {
  const text = document.getElementById(elementId).textContent;
  
  try {
    const response = await fetch('https://pastefy.app/api/paste', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        content: text,
        expireDate: null
      })
    });

    if (!response.ok) throw new Error('Error en la API');
    
    const data = await response.json();
    
    // Construir link como el ejemplo: https://pastefy.app/hOItdOkW/raw
    lastPasteLink = `https://pastefy.app/${data.id}/raw`;
    
    document.getElementById('pasteLink').textContent = lastPasteLink;
    document.getElementById('pasteModal').classList.add('show');
    
  } catch (error) {
    alert('Error al generar el link. Intenta de nuevo.');
    console.error(error);
  }
}

function copyPasteLink() {
  navigator.clipboard.writeText(lastPasteLink).then(() => {
    alert('Link copiado al portapapeles');
  });
}

function openPasteLink() {
  window.open(lastPasteLink, '_blank');
}

function closeModal() {
  document.getElementById('pasteModal').classList.remove('show');
}

function clearAll() {
  document.getElementById('input').value = '';
  document.getElementById('charCount').textContent = '0 caracteres';
  document.getElementById('rawCard').classList.remove('show');
  document.getElementById('obfCard').classList.remove('show');
}

updateCount();
</script>
</body>
</html>
